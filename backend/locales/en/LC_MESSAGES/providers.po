#: providers/models/core/models/model.py:212
msgid "Temperature"
msgstr "Temperature"

#: providers/models/core/models/model.py:213
msgid ""
"Controls randomness. Lower temperature results in less random "
"completions. As the temperature approaches zero, the model will become "
"deterministic and repetitive. Higher temperature results in more random "
"completions."
msgstr ""
"Controls randomness. Lower temperature results in less random "
"completions. As the temperature approaches zero, the model will become "
"deterministic and repetitive. Higher temperature results in more random "
"completions."

#: providers/models/core/models/model.py:223
msgid "Top P"
msgstr "Top P"

#: providers/models/core/models/model.py:224
msgid ""
"Controls diversity via nucleus sampling: 0.5 means half of all "
"likelihood-weighted options are considered."
msgstr ""
"Controls diversity via nucleus sampling: 0.5 means half of all "
"likelihood-weighted options are considered."

#: providers/models/core/models/model.py:233
msgid "Top K"
msgstr "Top K"

#: providers/models/core/models/model.py:234
msgid ""
"Limits the number of tokens to consider for each step by keeping only the"
" k most likely tokens."
msgstr ""
"Limits the number of tokens to consider for each step by keeping only the"
" k most likely tokens."

#: providers/models/core/models/model.py:241
msgid "Presence Penalty"
msgstr "Presence Penalty"

#: providers/models/core/models/model.py:242
msgid "Applies a penalty to the log-probability of tokens already in the text."
msgstr "Applies a penalty to the log-probability of tokens already in the text."

#: providers/models/core/models/model.py:250
msgid "Frequency Penalty"
msgstr "Frequency Penalty"

#: providers/models/core/models/model.py:251
msgid ""
"Applies a penalty to the log-probability of tokens that appear in the "
"text."
msgstr ""
"Applies a penalty to the log-probability of tokens that appear in the "
"text."

#: providers/models/core/models/model.py:259
msgid "Max Tokens"
msgstr "Max Tokens"

#: providers/models/core/models/model.py:260
#: providers/models/deepseek/llm/schemas/deepseek_chat.py:34
msgid ""
"Specifies the upper limit on the length of generated results. If the "
"generated results are truncated, you can increase this parameter."
msgstr ""
"Specifies the upper limit on the length of generated results. If the "
"generated results are truncated, you can increase this parameter."

