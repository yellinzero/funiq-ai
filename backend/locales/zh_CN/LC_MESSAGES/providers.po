#: providers/models/anthropic/llm/schemas/claude_3_7_sonnet.py:54
msgid "Only sample from the top K options for each subsequent token."
msgstr "仅从每个后续标记的前 K 个选项中采样。"

#: providers/models/anthropic/llm/schemas/claude_3_7_sonnet.py:24
msgid "Thinking"
msgstr "推理模式"

#: providers/models/anthropic/llm/schemas/claude_3_7_sonnet.py:26
msgid ""
"Controls the model's thinking capability. When enabled, temperature, "
"top_p and top_k will be disabled."
msgstr "控制模型的推理能力。启用时，temperature、top_p和top_k将被禁用。"

#: providers/models/anthropic/llm/schemas/claude_3_7_sonnet.py:34
msgid "Thinking Budget"
msgstr "推理预算"

#: providers/models/anthropic/llm/schemas/claude_3_7_sonnet.py:36
msgid ""
"Budget limit for thinking (minimum 1024), must be less than max_tokens. "
"Only available when thinking mode is enabled."
msgstr "推理的预算限制（最小1024），必须小于max_tokens。仅在推理模式启用时可用。"

#: providers/models/anthropic/llm/schemas/claude_3_7_sonnet.py:52
#, fuzzy
msgid "Top k"
msgstr "Top K"

#: providers/models/core/schemas/model.py:218
msgid "Temperature"
msgstr "温度"

#: providers/models/core/schemas/model.py:220
msgid ""
"Controls randomness. Lower temperature results in less random "
"completions. As the temperature approaches zero, the model will become "
"deterministic and repetitive. Higher temperature results in more random "
"completions."
msgstr "控制随机性。较低的温度会产生较少的随机完成。当温度接近零时，模型将变得确定性和重复性。较高的温度会产生更多的随机完成。"

#: providers/models/core/schemas/model.py:232
msgid "Top P"
msgstr "Top P"

#: providers/models/core/schemas/model.py:234
msgid ""
"Controls diversity via nucleus sampling: 0.5 means half of all "
"likelihood-weighted options are considered."
msgstr "通过核采样控制多样性：0.5 表示考虑所有可能性加权选项的一半。"

#: providers/models/core/schemas/model.py:245
msgid "Top K"
msgstr "Top K"

#: providers/models/core/schemas/model.py:247
msgid ""
"Limits the number of tokens to consider for each step by keeping only the"
" k most likely tokens."
msgstr "通过仅保留 k 个最可能的标记来限制每一步要考虑的标记数量。"

#: providers/models/core/schemas/model.py:256
msgid "Presence Penalty"
msgstr "存在惩罚"

#: providers/models/core/schemas/model.py:257
msgid "Applies a penalty to the log-probability of tokens already in the text."
msgstr "对文本中已有标记的对数概率施加惩罚。"

#: providers/models/core/schemas/model.py:265
msgid "Frequency Penalty"
msgstr "频率惩罚"

#: providers/models/core/schemas/model.py:267
msgid ""
"Applies a penalty to the log-probability of tokens that appear in the "
"text."
msgstr "对出现在文本中的标记的对数概率施加惩罚。"

#: providers/models/core/schemas/model.py:276
msgid "Max Tokens"
msgstr "最大标记数"

#: providers/models/core/schemas/model.py:278
#: providers/models/deepseek/llm/schemas/deepseek_chat.py:39
msgid ""
"Specifies the upper limit on the length of generated results. If the "
"generated results are truncated, you can increase this parameter."
msgstr "指定生成结果长度的上限。如果生成的结果被截断，你可以增加这个参数。"

