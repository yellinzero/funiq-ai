#: providers/models/openai/openai_schema.py:5
msgid "OpenAI"
msgstr "OpenAI"

#: providers/models/openai/openai_schema.py:6
msgid "Models provided by OpenAI, such as GPT-3.5-Turbo and GPT-4."
msgstr "OpenAI 提供的模型，如 GPT-3.5-Turbo 和 GPT-4。"

#: providers/models/openai/openai_schema.py:12
msgid "Get your API Key from OpenAI"
msgstr "从 OpenAI 获取 API 密钥"

#: providers/models/openai/openai_schema.py:37
msgid "Organization ID"
msgstr "组织 ID"

#: providers/models/openai/openai_schema.py:38
msgid "Enter your Organization ID"
msgstr "输入你的组织 ID"

#: providers/models/openai/openai_schema.py:42
msgid "API Base"
msgstr "API 基础地址"

#: providers/models/openai/openai_schema.py:43
